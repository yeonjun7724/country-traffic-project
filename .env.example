# LogisRisk Enterprise 환경변수 예시 — 이 파일을 .env 로 복사해 값을 채우세요. (.env 는 커밋 금지)

# AI Copilot (미설정 시 규칙 기반 모드로 동작)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOGISRISK_AI_TIMEOUT_SEC=30
LOGISRISK_AI_MAX_TOOL_ROUNDS=4
LOGISRISK_AI_MAX_CALLS_PER_SESSION=40

# 저장소. 미설정 시 sqlite:///<LOGISRISK_DATA_DIR>/logisrisk.db
# PostgreSQL 전환 시: pip install "psycopg[binary]" 후
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# SQLite 파일 위치 (Railway 에서는 Volume 마운트 경로, 예: /data)
LOGISRISK_DATA_DIR=

# 배포 접근 제어: 설정 시 앱 진입에 공용 접근 코드 필요 (공개 URL 배포 시 반드시 설정)
LOGISRISK_ACCESS_CODE=
# 1 = 로컬 모드(설정 화면의 역할 전환 테스트 기능 노출). Railway 에서는 기본 0
LOGISRISK_LOCAL_MODE=
